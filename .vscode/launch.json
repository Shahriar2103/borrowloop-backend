{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BorrowLoop: Run API",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "BorrowLoop: Seed MongoDB (drop & reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": ["--app", "run", "seed-db", "--drop"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {"DB_MODE": "mongo"},
      "console": "integratedTerminal"
    },
    {
      "name": "BorrowLoop: Regenerate dataset",
      "type": "debugpy",
      "request": "launch",
      "module": "data.generate_dataset",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "BorrowLoop: Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
