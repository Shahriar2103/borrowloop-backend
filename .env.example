# ---- BorrowLoop local settings (safe development defaults) ----
APP_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# auto  = use MongoDB at MONGO_URI if it is running, otherwise an in-memory database
# mongo = require a real MongoDB server
# mock  = always use the in-memory database
DB_MODE=auto
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=borrowloop
MONGO_TIMEOUT_MS=2000

# Load data/seed/*.json automatically when the database is empty
AUTO_SEED=true

SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string
JWT_EXPIRES_HOURS=24
CORS_ORIGINS=*
LOG_LEVEL=INFO
