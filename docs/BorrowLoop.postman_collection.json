{
  "info": {
    "name": "BorrowLoop API",
    "description": "Run the three 'Login as ...' requests first - they store tokens in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000/api"
    },
    {
      "key": "borrowerToken",
      "value": ""
    },
    {
      "key": "lenderToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Meta",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Endpoint index",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          }
        },
        {
          "name": "Categories & conditions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Guest",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sam Carter\",\n  \"email\": \"sam.carter@example.com\",\n  \"password\": \"Secret123\",\n  \"role\": \"borrower\",\n  \"neighbourhood\": \"Hackney Central\",\n  \"interests\": [\n    \"books\",\n    \"tools\"\n  ]\n}"
            }
          }
        },
        {
          "name": "Login as borrower",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"borrower@borrowloop.com\",\n  \"password\": \"Password@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success) { pm.collectionVariables.set('borrowerToken', body.data.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as lender",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lender@borrowloop.com\",\n  \"password\": \"Password@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success) { pm.collectionVariables.set('lenderToken', body.data.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@borrowloop.com\",\n  \"password\": \"Admin@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success) { pm.collectionVariables.set('adminToken', body.data.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List available items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items?page=1&per_page=10&sort=-created_at",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "-created_at"
                }
              ]
            }
          }
        },
        {
          "name": "Item details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/ITM-00001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "ITM-00001"
              ]
            }
          }
        },
        {
          "name": "Search items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/search?category=electronics&name=camera&available=all&max_deposit=200",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "search"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "electronics"
                },
                {
                  "key": "name",
                  "value": "camera"
                },
                {
                  "key": "available",
                  "value": "all"
                },
                {
                  "key": "max_deposit",
                  "value": "200"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Users",
      "item": [
        {
          "name": "My account",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "View profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/USR-00003",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "USR-00003"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/USR-00004",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "USR-00004"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Student who borrows more than buys!\",\n  \"preferences\": {\n    \"notifications\": {\n      \"events\": {\n        \"return_reminders\": {\n          \"schedule\": {\n            \"days_before_due\": 2\n          }\n        }\n      }\n    }\n  }\n}"
            }
          }
        },
        {
          "name": "Trust score",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/USR-00004/trust-score",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "USR-00004",
                "trust-score"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "User's listings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/USR-00003/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "USR-00003",
                "items"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Items",
      "item": [
        {
          "name": "Add item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lenderToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bosch Laser Measure\",\n  \"category\": \"tools\",\n  \"subcategory\": \"hand_tools\",\n  \"description\": \"Accurate laser distance measure up to 50m.\",\n  \"condition\": \"like_new\",\n  \"deposit\": 25,\n  \"tags\": [\n    \"measure\",\n    \"diy\"\n  ],\n  \"lending_rules\": {\n    \"min_days\": 1,\n    \"max_days\": 7,\n    \"min_trust_score\": 40\n  },\n  \"pickup_methods\": [\n    \"collection\",\n    \"meetup\"\n  ],\n  \"specifications\": {\n    \"technical\": {\n      \"range\": {\n        \"max_m\": 50,\n        \"accuracy_mm\": 1.5\n      }\n    }\n  }\n}"
            }
          }
        },
        {
          "name": "Update my item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items/ITM-00111",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "ITM-00111"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lenderToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deposit\": 160,\n  \"description\": \"Mirrorless camera vlogging kit with two batteries and a 64GB card.\"\n}"
            }
          }
        },
        {
          "name": "Remove my item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/ITM-00001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "ITM-00001"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lenderToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Borrow requests",
      "item": [
        {
          "name": "Request an item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/borrow-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "borrow-requests"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_id\": \"ITM-00003\",\n  \"start_date\": \"2026-11-01\",\n  \"return_date\": \"2026-11-04\",\n  \"message\": \"Could I borrow this for a long weekend?\",\n  \"pickup_method\": \"collection\"\n}"
            }
          }
        },
        {
          "name": "My requests (as borrower)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/borrow-requests?role=borrower&status=pending,accepted",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "borrow-requests"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "borrower"
                },
                {
                  "key": "status",
                  "value": "pending,accepted"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Requests for my items (as lender)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/borrow-requests?role=lender&status=pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "borrow-requests"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "lender"
                },
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lenderToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Accept a request",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/borrow-requests/REQ-00582",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "borrow-requests",
                "REQ-00582"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lenderToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"accepted\"\n}"
            }
          }
        },
        {
          "name": "Reject a request",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/borrow-requests/REQ-00599",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "borrow-requests",
                "REQ-00599"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lenderToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\",\n  \"reason\": \"Sorry, I need it that weekend.\"\n}"
            }
          }
        },
        {
          "name": "Change dates (borrower) - uses the request you created above",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/borrow-requests/REQ-00615",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "borrow-requests",
                "REQ-00615"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_date\": \"2026-11-02\",\n  \"return_date\": \"2026-11-05\",\n  \"message\": \"Could we shift by a day?\"\n}"
            }
          }
        },
        {
          "name": "Cancel my request - uses the request you created above",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/borrow-requests/REQ-00615",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "borrow-requests",
                "REQ-00615"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Plans changed\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Transactions",
      "item": [
        {
          "name": "Record collection (start transaction)",
