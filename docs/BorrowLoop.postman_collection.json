              "raw": "{{baseUrl}}/transactions/TXN-00001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions",
                "TXN-00001"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Record return (complete) - uses the transaction created above",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions/TXN-00400",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions",
                "TXN-00400"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lenderToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"return_condition\": \"good\",\n  \"notes\": \"All accessories returned\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "6. Reviews",
      "item": [
        {
          "name": "Leave a review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{borrowerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"TXN-00374\",\n  \"rating\": 5,\n  \"comment\": \"Great experience, item exactly as described.\",\n  \"aspects\": {\n    \"communication\": 5,\n    \"item_accuracy\": 5,\n    \"punctuality\": 4\n  }\n}"
            }
